<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>x.com login</title>
    <link rel="stylesheet" href="/css/login_style.css">
    <style>
        .error-msg,#error-msg{
            color: rgb(255, 74, 74);
            font-size: .8rem;
        }
    </style>
</head>
<body>
    <div class="logo-container">
            <img src="/assets/x_logo.jpeg" alt="logo" id="img-logo">
        </div>
   <div class="container">
    <h1 style="text-align: center;margin-bottom: 20px;">Reset Password</h1>
     <form action="">
        
        <div>
            <label for="password">Password</label>
        <input type="password" name="password" id="password">
        
        </div>
        <div>
            <label for="confirm_password">Confirm Password</label>
        <input type="password" name="confirm_password" id="confirm_password">
        
        </div>
        <div>
            <input type="submit" value="Reset Password" id="submitbtn" class="submitbtn">
        <p id="error-msg"></p>
        
        </div>
        
    </form>
   </div>
    <script type="module" src="/js/reset_password_script.js"></script>
</body>
</html>
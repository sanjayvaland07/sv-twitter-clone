<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>x.com login</title>
    <link rel="stylesheet" href="/css/login_style.css">
    <style>
        .error-msg,#error-msg{
            color: rgb(255, 74, 74);
            font-size: .8rem;
        }
    </style>
</head>
<body>
    <div class="logo-container">
            <img src="/assets/x_logo.jpeg" alt="logo" id="img-logo">
        </div>
   <div class="container">
    <h1 style="text-align: center;margin-bottom: 20px;">Login</h1>
     <form action="">
        <div>
            <label for="user">Enter username or email</label>
        <input type="text" name="user" id="user">
        </div>
        <div>
            <label for="password">Password</label>
        <input type="password" name="password" id="password">
        <a href="/forgetpassword" id="forget-password-link">forget password?</a>
        </div>
        <div>
            <input type="submit" value="Login" id="loginbtn" class="submitbtn">
        <p id="error-msg"></p>
        <a href="/register" id="register-link">don't have account?</a>
        </div>
        
    </form>
   </div>
    <script type="module" src="/js/login_script.js"></script>
</body>
</html>
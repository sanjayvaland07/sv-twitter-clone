<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>x.com forget password link</title>
    <link rel="stylesheet" href="/css/login_style.css">
</head>
<body>
    <div class="logo-container">
            <img src="/assets/x_logo.jpeg" alt="logo" id="img-logo">
        </div>
   <div class="container">
    <h1 style="text-align: center;margin-bottom: 20px;">Generated OTP</h1>
     <form action="">
        <div>
            <h1 id="otp">Your OTP is : <span id="otptext"><%= otp %></span></h1>
            <p style="color: white;">this opt is valid for only 2 min</p>
        </div>
        <div>
            <input type="submit" value="copy OTP" id="copybtn" class="submitbtn">
        <p id="error-msg"></p>
        </div>
        
    </form>
    <script>
        const copybtn = document.getElementById("copybtn")
        copybtn.addEventListener("click",async (e)=>{
            e.preventDefault()
            try{
                await navigator.clipboard.writeText(document.getElementById("otptext").innerText)
                console.log("copy")
                alert("opt copied")
                // window.location.href = "/otp_verification"
            }catch(err){console.log(err)}
        })
    </script>
   </div>
</body>
</html>
<div class="modal-overlay hide-popup" id="followers_popup">
    <div class="popup">
        <div class="popup-header">
            <h2>Followers</h2>
            <button class="close-btn" id="popup-close-followers">&times;</button>
        </div>

        <div class="following-list">
            <!-- User Item -->
            <% for(let i=0;i<user_followers.length;i++){ %>

                <div class="user-item">
                    <div class="avatar">
                        <img style="width: 100%;height: 100%; border-radius: 50%;"
                            src="<%= user_followers[i].profile_picture %>" alt="">
                    </div>
                    <div class="user-info">
                        <span class="username">
                            <%= user_followers[i].username %>
                        </span>
                        <span class="full-name">
                            <%= user_followers[i].first_name %>
                                <%= user_followers[i].last_name %>
                        </span>
                    </div>
                    <button class="unfollow-btn" id="remove_follower"
                        data-userid="<%= user_followers[i].id %>">Remove</button>
                </div>
                <% } %>

                    <!-- Add more user-items as needed -->
        </div>
    </div>
</div>

<script>
    document.getElementById("popup-close-followers")?.addEventListener("click", (e) => {
        console.log("click")
        document.getElementById("followers_popup").classList.add("hide-popup")
    })

    const remove_followers = document.querySelectorAll(".unfollow-btn")
    remove_followers?.forEach(btn => {
        btn.addEventListener("click", async (e) => {
            const userid = remove_follower.dataset.userid
            if (userid) {
                const response = await fetch("/user/remove_follower/" + userid, {
                    method: 'delete',
                    headers: {
                        'Content-Type': 'application/json'
                    }
                })

                if (response.ok) {
                    window.location.reload();
                } else {
                    const data = await response.json();
                    console.log(data);
                }
            }
        })
    })
</script>
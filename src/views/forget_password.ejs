<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>x.com forget password</title>
    <link rel="stylesheet" href="/css/login_style.css">
</head>
<body>
    <div class="logo-container">
            <img src="/assets/x_logo.jpeg" alt="logo" id="img-logo">
        </div>
   <div class="container">
    <h1 style="text-align: center;margin-bottom: 20px;">Forget Password</h1>
     <form action="">
        <div>
        <label for="email">Enter email</label>
        <input type="text" name="email" id="email">
        </div>
        <div>
            <input type="submit" value="Forget Password" id="forgetpasswordbtn" class="submitbtn">
        <p id="error-msg"></p>
        </div>
        
    </form>
    <script type="module" src="/js/forgetpassword_script.js"></script>
   </div>
</body>
</html>
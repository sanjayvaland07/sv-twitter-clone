<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>X.com Profile</title>
    <link rel="stylesheet" href="/css/user_css/profile.css">
    <link rel="stylesheet" href="/css/common/sidebar.css">
    <link rel="stylesheet" href="/css/common/tweet.css">
    <link rel="stylesheet" href="/css/common/follows_popup.css">
    <link rel="stylesheet" href="/css/common/mobile_responsive_header.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/7.0.1/css/all.min.css"
        integrity="sha512-2SwdPD6INVrV/lHTZbO2nodKhrnDdJK9/kg2XD1r9uGqPo1cUbujc+IYdlYdEErWNu69gVcYgdxlmVmzTWnetw=="
        crossorigin="anonymous" referrerpolicy="no-referrer" />
    <style>
        .popup-link {
            text-decoration: none;
            color: white;
        }

        .sidebar ul .li-profile {
            background-color: #1d9bf0;
            border-radius: 10px;
        }
    </style>
    <!-- <link rel="stylesheet" href="https://cloudflare.com"> -->
</head>

<body>
    <!-- comment popup -->
    <%- include("../common/comment_popup") %>

        <!-- followwing popup -->
        <%- include('../common/following_popup') %>
            <%- include('../common/followers_popup') %>

                <!-- side bar -->
                <%- include('../common/sidebar') %>

                    <!-- Main Content -->
                    <main class="main-content">
                        <!-- Cover Picture -->
                        <div class="cover-wrapper">
                            <img src='<%= userdata.cover_picture %>' alt="Cover" class="cover-img">
                            <div class="cover-overlay"></div>
                        </div>

                        <div class="profile-container">
                            <header class="profile-header">
                                <div style="display: flex;flex-direction: column;">
                                    <h3 style="text-align: center;">
                                        <%= userdata.username || "sanjay" %>
                                    </h3>
                                    <div class="avatar-wrapper">
                                        <img src='<%= userdata.profile_picture %>' alt="Profile" class="profile-avatar">
                                    </div>
                                </div>

                                <div class="profile-info">
                                    <div class="user-row">
                                        <strong>
                                            <%= userdata.first_name %>
                                        </strong> <strong>
                                            <%= userdata.last_name %>
                                        </strong>
                                        <button class="edit-btn" id="editbtn"><a
                                                href="/user/edit/<%= userdata.id %>">Edit
                                                Profile</a></button>

                                    </div>

                                    <ul class="stats">
                                        <li><strong>
                                                <%= user_tweets.length%>
                                            </strong> tweets</li>
                                        <li><a href="" id="followersbtn" class="popup-link">
                                                <strong>
                                                    <%= user_followers.length %>
                                                </strong> followers
                                            </a></li>
                                        <li><a href="" id="followingbtn" class="popup-link">
                                                <strong>
                                                    <%= user_followings.length %>
                                                </strong> following
                                            </a></li>
                                    </ul>
                                    <div class="bio">
                                        <p id="timezone"></p>
                                        <%= userdata.bio %>
                                    </div>
                                </div>
                            </header>

                            <!-- Post Grid -->
                            <div class="grid-nav">
                                
                                <% if(section=="retweet" ) { %>
                                <a href="/user/profile"><i class="fa-solid fa-table-cells"></i>TWEETS</a>
                                <a href="/user/get_user_retweets" class="active">Re Tweets</a>
                                <% } else { %>
                                <a href="/user/profile" class="active"><i class="fa-solid fa-table-cells"></i>TWEETS</a>
                                <a href="/user/get_user_retweets">Re Tweets</a>
                                <% } %>
                                                    <!-- <a href="#"><i class="fa-solid fa-clapperboard"></i> REELS</a>
                <a href="#"><i class="fa-solid fa-user-tag"></i> TAGGED</a> -->
                            </div>

                            <div class="tweet-container">
                                <% if(section=="retweet" ) { %>
                                    <!-- Tweet 1: With Image -->
                                    <% for(let i=0;i<retweets.length;i++) {%>

                                        <div class="tweet">
                                            <div class="profile-col">
                                                <div class="avatar"
                                                    style="background-image: url('<%= tweet_userdata[i].profile_picture %>'); background-size: cover;">
                                                </div>
                                            </div>
                                            <div class="tweet-content">
                                                <div class="tweet-header">
                                                    <span class="display-name">
                                                        <%= tweet_userdata[i].username %>
                                                    </span>
                                                    <!-- <span class="username">@alex_dev</span> -->
                                                    <span class="dot">·</span>
                                                    <span class="timestamp">2h</span>
                                                </div>
                                                <div class="text-body">
                                                    <%= retweets[i].tweet_content %>
                                                </div>
                                                <img src="<%= retweets[i].media_url %>" alt="" class="tweet-image">
                                                <div class="tweet-footer">
                                                    <div class="footer-item comment"
                                                        data-tweetid="<%= retweets[i].id %>">
                                                        <span>💬</span><span class="comment_count"
                                                            id="comment_count_<%= retweets[i].id %>">
                                                            <%= comments[i].comment_count %>
                                                        </span>
                                                    </div>

                                                    <div class="footer-item like" data-tweetid="<%= retweets[i].id %>">
                                                        <span style="font-size: 1.5rem;color: white;">
                                                            <% if(likes[i].like_by_me==1) {%>
                                                                ❤️
                                                                <% }else{ %>
                                                                    ♡
                                                                    <% } %>
                                                        </span>
                                                        <span class="like-count">
                                                            <%= likes[i].like_count %>
                                                        </span>
                                                    </div>

                                                </div>
                                            </div>
                                        </div>
                                        <% } %>
                                            <% } else { %>
                                                <% for(let i=0;i<user_tweets.length;i++) {%>
                                                    <!-- <p><%= user_tweets[i].tweet_content %></p> -->
                                                    <div class="tweet">
                                                        <div class="profile-col">
                                                            <div class="avatar"
                                                                style="background-image: url('<%= userdata.profile_picture %>'); background-size: cover;">
                                                            </div>
                                                        </div>
                                                        <div class="tweet-content">
                                                            <div class="tweet-header">
                                                                <span class="display-name">
                                                                    <%= userdata.username %>
                                                                </span>
                                                                <!-- <span class="username">@alex_dev</span> -->
                                                                <span class="dot">·</span>
                                                                <span class="timestamp">2h</span>
                                                            </div>
                                                            <div class="text-body">
                                                                <%= user_tweets[i].tweet_content %>
                                                            </div>
                                                            <img src="<%= user_tweets[i].media_url %>" alt=""
                                                                class="tweet-image">
                                                            <div class="tweet-footer">
                                                                <div class="footer-item comment"
                                                                    data-tweetid="<%= user_tweet_likes[i].tweet_id %>">
                                                                    <span>💬</span><span class="comment_count"
                                                                        id="comment_count_<%= user_tweet_likes[i].tweet_id %>">
                                                                        <%= comments[i].comment_count %>
                                                                    </span>
                                                                </div>
                                                                <div class="footer-item retweet-btn"
                                                                    data-tweetid="<%= user_tweet_likes[i].tweet_id %>">
                                                                    <span>🔁</span><span id="retweet_count">
                                                                        <%= user_retweet[i].retweet_count %>
                                                                    </span></div>
                                                                <div class="footer-item like"
                                                                    data-tweetid="<%= user_tweet_likes[i].tweet_id %>">
                                                                    <span style="font-size: 1.5rem;color: white;">
                                                                        <% if(user_tweet_likes[i].like_by_me==1) {%>
                                                                            ❤️
                                                                            <% }else{ %>
                                                                                ♡
                                                                                <% } %>
                                                                    </span>
                                                                    <span class="like-count">
                                                                        <%= user_tweet_likes[i].like_count %>
                                                                    </span>
                                                                </div>
                                                                <div class="footer-item delete-btns"
                                                                    data-tweetid="<%= user_tweet_likes[i].tweet_id %>"
                                                                    data-userid="<%= user_tweets[i].user_id %>"><i
                                                                        class="fa-solid fa-trash"></i>Delete</div>
                                                            </div>
                                                        </div>
                                                    </div>
                                                    <% } %>
                                                        <% } %>
                            </div>
                        </div>
                    </main>

                    <%- include('../common/mobile_responsive_header') %>
                        <script>
                            document.getElementById("timezone").innerHTML = "TimeZone : " + Intl.DateTimeFormat().resolvedOptions().timeZone;
                            const editbtn = document.getElementById("editbtn")
                            editbtn.firstElementChild.style = "text-decoration:none;color:white"

                            document.getElementById("followingbtn").addEventListener("click", (e) => {
                                e.preventDefault()
                                document.getElementById("following_popup").classList.remove("hide-popup")
                            })
                            document.getElementById("followersbtn").addEventListener("click", (e) => {
                                e.preventDefault()
                                document.getElementById("followers_popup").classList.remove("hide-popup")
                            })

                            const deletebtns = document.querySelectorAll(".delete-btns");
                            deletebtns.forEach(btn => {
                                btn.addEventListener("click", async () => {
                                    console.log(btn.dataset.tweetid, btn.dataset.userid)
                                    const tweetid = btn.dataset.tweetid
                                    const userid = btn.dataset.userid;
                                    if (!tweetid || !userid) {
                                        alert("can't delete tweet")
                                    }

                                    const confirmed = confirm("are you sure want to delete tweet?")
                                    console.log(confirmed)
                                    if (!confirmed) return

                                    const response = await fetch("/user/delete_user_tweet", {
                                        method: 'post',
                                        headers: {
                                            'Content-Type': 'application/json'
                                        },
                                        body: JSON.stringify({ tweet_id: tweetid, user_id: userid })
                                    })
                                    if (response.ok) {
                                        alert("tweet delete successfully")
                                        window.location.reload();
                                    } else {
                                        alert("can't delete your tweet, try after sometime")
                                    }
                                })
                            })

                        </script>
                        <script type="module" src="/js/user/tweet_functionality.js"></script>
</body>

</html>